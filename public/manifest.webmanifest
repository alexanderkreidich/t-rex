    { "src": "/icons/icon-maskable-192.png?v=rex2", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png?v=rex2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
